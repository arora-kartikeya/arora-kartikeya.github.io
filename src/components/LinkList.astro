---
type LinkItem = {
  label: string;
  href: string;
  placeholder?: boolean;
};

type Props = {
  links: LinkItem[];
};
---

<ul class="link-list" role="list">
  {
    Astro.props.links.map((link) => (
      <li>
        <a href={link.href}>
          {link.label}
          {link.placeholder && <span class="placeholder-label">placeholder</span>}
        </a>
      </li>
    ))
  }
</ul>
