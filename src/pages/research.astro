---
import SectionHeader from "@/components/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Research"
  description="Research interests in quantum sensing and quantum information theory."
>
  <section class="page">
    <SectionHeader
      eyebrow="Research"
      title="Theory for sensing, information, and inference in quantum systems."
      description="This page is structured as an editable overview of current and future research directions."
    />

    <div class="grid">
      <article class="card">
        <h2>Quantum sensing</h2>
        <p>
          Placeholder summary for work on quantum-enhanced sensing protocols,
          precision limits, measurement design, and physical settings where
          quantum resources can improve inference.
        </p>
      </article>
      <article class="card">
        <h2>Quantum information theory</h2>
        <p>
          Placeholder summary for interests in channels, distinguishability,
          entanglement, resource tradeoffs, and information-theoretic bounds.
        </p>
      </article>
      <article class="card">
        <h2>Current directions</h2>
        <p>
          Replace this text with active problems, collaborations, and near-term
          questions once project descriptions are ready to publish.
        </p>
      </article>
      <article class="card">
        <h2>Group context</h2>
        <p>
          Work is carried out in Quntao Zhuang's group at USC. The group link
          is currently a visible placeholder in the site configuration.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
